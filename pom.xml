<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jahia.modules</groupId>
        <artifactId>jahia-modules</artifactId>
        <version>8.2.3.2</version>
    </parent>

    <groupId>org.jahia.support</groupId>
    <artifactId>content-revision-history</artifactId>
    <name>Content Revision History</name>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>bundle</packaging>
    <description>Public, curated revision history for Jahia pages: Markdown snapshots taken on
        publication, promoted by editors into named public revisions, with a diff viewer.
    </description>

    <properties>
        <jahia-depends>default</jahia-depends>
        <jahia-module-type>module</jahia-module-type>
        <!-- REQUIRED: without this the Jahia blueprint extender silently skips the bundle,
             so no module Spring context is created and every code extension point
             (Actions, render filters) is inert while views and CNDs still work fine. -->
        <require-capability>osgi.extender;filter:="(osgi.extender=org.jahia.bundles.blueprint.extender.config)"</require-capability>
        <jahia.version>8.2.3.2</jahia.version>
        <!-- Ship build provenance: a module whose whole purpose is an auditable record has no
             business being un-auditable itself. -->
        <skip.git.commit.info>false</skip.git.commit.info>
        <!-- Wildcard only. Explicit imports here are hard OSGi resolution requirements, so
             naming a package the code does not use turns an unrelated platform change into a
             bundle that will not resolve at all. difflib (java-diff-utils 1.3, unmaintained
             since 2011) was imported for a diff viewer that does not exist yet. -->
        <import-package>*</import-package>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jahia.server</groupId>
            <artifactId>jahia-api</artifactId>
            <version>${jahia.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jahia.server</groupId>
            <artifactId>jahia-impl</artifactId>
            <version>${jahia.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jahia.server</groupId>
            <artifactId>jahia-taglib</artifactId>
            <version>${jahia.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <!-- Real HTML parser for MarkdownNormalizer: replaces the regex pipeline (ReDoS risk,
             entity-decoding-order bugs). The platform ships jsoup but does not export
             org.jsoup, so this must stay compile-scoped and be embedded in the bundle
             (see the parent pom's embed-dependency instruction). -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.21.2</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <!-- Suppress dev-mode source mounting: it makes
                             ModulesSourceSpringInitializer take over Spring handling. -->
                        <Jahia-Source-Folders/>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
