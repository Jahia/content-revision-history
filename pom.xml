<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jahia.modules</groupId>
        <artifactId>jahia-modules</artifactId>
        <version>8.2.3.2</version>
    </parent>

    <groupId>org.jahia.support</groupId>
    <artifactId>content-revision-history</artifactId>
    <name>Content Revision History</name>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>bundle</packaging>
    <description>Public, curated revision history for Jahia pages: Markdown snapshots taken on
        publication, promoted by editors into named public revisions, with a diff viewer.
    </description>

    <properties>
        <jahia-depends>default</jahia-depends>
        <jahia-module-type>module</jahia-module-type>
        <!-- REQUIRED: without this the Jahia blueprint extender silently skips the bundle,
             so no module Spring context is created and every code extension point
             (Actions, render filters) is inert while views and CNDs still work fine. -->
        <require-capability>osgi.extender;filter:="(osgi.extender=org.jahia.bundles.blueprint.extender.config)"</require-capability>
        <jahia.version>8.2.3.2</jahia.version>
        <!-- No git metadata plugin: keeps the build green before the first commit. -->
        <skip.git.commit.info>true</skip.git.commit.info>
        <!-- difflib is exported by the platform (see karaf/etc/custom-jahia.system.packages.generated.properties).
             Import it rather than embedding a fork, to avoid duplicate classes. -->
        <import-package>difflib,difflib.myers,org.springframework.beans.factory.xml,org.springframework.context.support,*</import-package>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jahia.server</groupId>
            <artifactId>jahia-api</artifactId>
            <version>${jahia.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jahia.server</groupId>
            <artifactId>jahia-impl</artifactId>
            <version>${jahia.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jahia.server</groupId>
            <artifactId>jahia-taglib</artifactId>
            <version>${jahia.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <!-- Suppress dev-mode source mounting: it makes
                             ModulesSourceSpringInitializer take over Spring handling. -->
                        <Jahia-Source-Folders/>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
