<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jahia.modules</groupId>
        <artifactId>jahia-modules</artifactId>
        <version>8.2.3.2</version>
    </parent>

    <groupId>org.jahia.support</groupId>
    <artifactId>content-revision-history</artifactId>
    <name>Content Revision History</name>
    <!-- 1.1.0 ships initial JCR content (src/main/import/repository.xml) for the first time.
         Jahia imports a module's initial content ONCE PER VERSION, so a new import (or any
         change to an existing one) only takes effect on a version bump. Redeploying the same
         version leaves the repository untouched and the change looks silently ignored. -->
    <version>1.2.0-SNAPSHOT</version>

    <!-- Without these the parent's own SCM is inherited, so the module advertises Jahia's
         internal repository as its source. A store listing that offers a source link would send
         readers somewhere they cannot go and that is not this module. -->
    <url>https://github.com/Jahia/content-revision-history</url>
    <scm>
        <connection>scm:git:git@github.com:Jahia/content-revision-history.git</connection>
        <developerConnection>scm:git:git@github.com:Jahia/content-revision-history.git</developerConnection>
        <url>https://github.com/Jahia/content-revision-history</url>
        <tag>HEAD</tag>
    </scm>
    <packaging>bundle</packaging>
    <description>Public, curated revision history for Jahia pages: Markdown snapshots taken on
        publication, promoted by editors into named public revisions, with a diff viewer.
    </description>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <!-- The parent interpolates this into Jahia-Source-Folders. Left at its default it
             becomes the absolute path of whoever built the jar, which then ships in the manifest
             of a released artifact and points at a directory no customer has. Blank is the whole
             fix: dev-mode source mounting is a local convenience, not something to publish. -->
        <sourcesRoot></sourcesRoot>
        <jahia-depends>default</jahia-depends>
        <jahia-module-type>module</jahia-module-type>
        <!-- No Spring, no blueprint extender: this is a plain OSGi module and its one code
             extension point is a Declarative Services component. The blueprint route needed an
             explicit osgi.extender capability, and a bundle missing it deployed happily with
             working views and CNDs while every code extension point stayed inert and nothing
             said so. A DS descriptor is generated at build time, so its absence is visible in
             the jar instead of only in production. -->
        <jahia.version>8.2.3.2</jahia.version>
        <!-- Ship build provenance: a module whose whole purpose is an auditable record has no
             business being un-auditable itself. -->
        <skip.git.commit.info>false</skip.git.commit.info>
        <!-- Wildcard only. Explicit imports here are hard OSGi resolution requirements, so
             naming a package the code does not use turns an unrelated platform change into a
             bundle that will not resolve at all. difflib (java-diff-utils 1.3, unmaintained
             since 2011) was imported for a diff viewer that does not exist yet. -->
        <import-package>*</import-package>
    </properties>

    <dependencies>
        <!-- Compile-time only: the annotations are consumed by bnd to generate the DS
             descriptors and are not needed at runtime. -->
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
            <version>1.4.0</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.jahia.server</groupId>
            <artifactId>jahia-api</artifactId>
            <version>${jahia.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jahia.server</groupId>
            <artifactId>jahia-impl</artifactId>
            <version>${jahia.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jahia.server</groupId>
            <artifactId>jahia-taglib</artifactId>
            <version>${jahia.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.14.4</version>
            <scope>test</scope>
        </dependency>
        <!-- Only used to mock javax.management.MBeanServer for GuestMarkdownFetcherTest: the
             connector-probing logic branches on MBean attribute values and query failures that
             cannot be produced with a real MBeanServer in a unit test. Version pinned to what is
             already present in the local repository so the build stays offline. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.23.0</version>
            <scope>test</scope>
        </dependency>
        <!-- Real HTML parser for MarkdownNormalizer: replaces the regex pipeline (ReDoS risk,
             entity-decoding-order bugs). The platform ships jsoup but does not export org.jsoup, so this stays
             compile-scoped and is embedded in the bundle. Because it is EMBEDDED rather than
             imported, our copy is private to this bundle and can be patched independently of
             the platform's, which is why this is 1.23.1 (the advisory fix) rather than the
             1.21.2 the platform ships
             (see the parent pom's embed-dependency instruction). -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.23.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <!-- Belt and braces with the empty sourcesRoot property above. The
                             original reason for this was that dev-mode source mounting made
                             ModulesSourceSpringInitializer take over Spring handling; there is no
                             Spring here any more, but keeping the header empty also keeps a build
                             machine's directory layout out of the shipped manifest. -->
                        <Jahia-Source-Folders/>
                        <!-- Ship the licence inside the bundle: neither the parent pom nor bnd
                             does this automatically, and sibling Jahia modules carry
                             META-INF/LICENSE.txt. -->
                        <!-- {maven-resources} MUST be listed explicitly: naming Include-Resource replaces
                             bnd's default inclusion, which silently drops definitions.cnd, every
                             JSP view and the resource bundles, leaving a classes-only bundle that
                             deploys 'successfully' and registers no node types. -->
                        <Include-Resource>{maven-resources},META-INF/LICENSE.txt=LICENSE.txt</Include-Resource>
                        <!-- Declarative Services. bnd generates OSGI-INF/*.xml from the
                             annotations and adds the osgi.extender=osgi.component requirement,
                             which is what 48 of the shipped Jahia modules already use. Without
                             this instruction the annotations compile, produce no descriptor,
                             and the component silently never activates. -->
                        <_dsannotations>*</_dsannotations>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
            </plugin>
            <!-- Coverage reporting only, no enforced gate yet: this module is roughly
                 35-45% unit-testable (see class-level comments), the rest being JCR/HTTP/
                 Quartz/Spring glue exercised by the Cypress suite under tests/ instead. A hard
                 jacoco:check threshold would either fail the build today or be set so low it is
                 meaningless; revisit once the actual measured number is known. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
