<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Capture is triggered by publication, not by page traffic. The render filter this
         replaces could not deliver the guarantee: the HTML output cache short-circuits the
         chain before it, so history existed only for pages somebody happened to visit, and any
         anonymous request could force unlimited full re-renders plus repository writes.

         The bean registers itself with JCRPublicationService on module start and unregisters
         on stop, so a module undeploy leaves no dangling listener. -->
    <bean class="org.jahia.modules.revisionhistory.PublicationSnapshotListener"
          init-method="start" destroy-method="stop"/>

</beans>
