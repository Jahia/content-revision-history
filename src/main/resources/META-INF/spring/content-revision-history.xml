<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Jahia collects RenderFilter beans from the module Spring context into the render
         chain, mirroring how core filters are declared in applicationcontext-renderer.xml. -->
    <bean class="org.jahia.modules.revisionhistory.SnapshotCaptureFilter">
        <property name="priority" value="98"/>
        <property name="description"
                  value="Captures a Markdown revision snapshot of publicly revisioned pages"/>
    </bean>

</beans>
