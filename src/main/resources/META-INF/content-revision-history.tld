<?xml version="1.0" encoding="UTF-8" ?>
<taglib xmlns="http://java.sun.com/xml/ns/j2ee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee
                            http://java.sun.com/xml/ns/j2ee/web-jsptaglibrary_2_0.xsd"
        version="2.0">

    <description>Content Revision History view functions</description>
    <display-name>Content Revision History Functions</display-name>
    <tlib-version>1.0</tlib-version>
    <short-name>crh</short-name>
    <uri>http://www.jahia.org/content-revision-history/functions</uri>

    <function>
        <description>
            Sanitises editor-authored rich text so it can be rendered unescaped. Strips scripts,
            event handlers, styles, images and headings; keeps inline emphasis, links and lists.
        </description>
        <name>sanitize</name>
        <function-class>org.jahia.modules.revisionhistory.RevisionHistoryFunctions</function-class>
        <function-signature>java.lang.String sanitize(java.lang.String)</function-signature>
        <example>${crh:sanitize(currentNode.properties.summary.string)}</example>
    </function>

    <function>
        <description>
            A captured snapshot's Markdown payload, for the jContent preview. Read through the
            caller's own session, so the preview shows only what the viewer may already see.
        </description>
        <name>snapshotContent</name>
        <function-class>org.jahia.modules.revisionhistory.RevisionHistoryFunctions</function-class>
        <function-signature>org.jahia.modules.revisionhistory.SnapshotContent snapshotContent(org.jahia.services.content.JCRNodeWrapper)</function-signature>
        <example>${crh:snapshotContent(currentNode).markdown}</example>
    </function>

    <function>
        <description>
            A revision history's entries, newest first by revisionDate. The list view and the
            comparisons both order through this, so a control and the panel it opens can never
            mean different revisions.
        </description>
        <name>orderedEntries</name>
        <function-class>org.jahia.modules.revisionhistory.RevisionHistoryFunctions</function-class>
        <function-signature>java.util.List orderedEntries(org.jahia.services.content.JCRNodeWrapper)</function-signature>
        <example>${crh:orderedEntries(currentNode)}</example>
    </function>

    <function>
        <description>
            Compares two revisions of the same history. The first argument is the rendered
            revision-history node and is what restricts the two visitor-selected identifiers to
            entries of that history.
        </description>
        <name>compare</name>
        <function-class>org.jahia.modules.revisionhistory.RevisionHistoryFunctions</function-class>
        <function-signature>org.jahia.modules.revisionhistory.RevisionDiffView compare(java.lang.String, java.lang.String, java.lang.String, java.lang.String, java.lang.String)</function-signature>
        <example>${crh:compare(currentNode.identifier, selectedFrom, selectedTo, currentResource.locale, renderContext.workspace)}</example>
    </function>
    <function>
        <description>
            Every text-bearing property of a node, so the generic markdown fallback emits content
            rather than only a title. Nodes whose text lives outside jcr:title rendered empty
            without this, which lost content silently from a record meant to be authoritative.
        </description>
        <name>textProperties</name>
        <function-class>org.jahia.modules.revisionhistory.RevisionHistoryFunctions</function-class>
        <function-signature>java.util.List textProperties(org.jahia.services.content.JCRNodeWrapper)</function-signature>
    </function>
</taglib>
