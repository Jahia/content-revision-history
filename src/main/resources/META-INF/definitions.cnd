<jmix = 'http://www.jahia.org/jahia/mix/1.0'>
<jnt = 'http://www.jahia.org/jahia/nt/1.0'>
<crh = 'http://www.jahia.org/crh/1.0'>

// Opt-in marker. Only pages carrying this mixin are snapshotted on publication.
[jmix:publiclyRevisioned] mixin
 extends = jnt:page

// Public, editorial container rendered on the page. Holds only revision entries.
[crh:revisionHistory] > jnt:content, jmix:droppableContent, jmix:editorialContent, jmix:list
 // `orderable` is REQUIRED and is not implied by jmix:list -- jnt:contentList declares it
 // separately for exactly this reason. Without it Jackrabbit refuses reordering
 // ("child node ordering not supported on node ..."), so editors cannot drag entries into
 // order at all. Both the list view and the comparison treat the next sibling in editorial
 // order as the older revision, so a non-orderable history left that convention
 // unachievable: the order was whatever insertion order the repository happened to give,
 // and "compare with previous" could name a pair the editor never chose.
 orderable
 itemtype = content
 - historyTitle (string) i18n
 // Whether the list starts closed. Defaults to true: a revision history is supporting
 // evidence for the page, not the page, and a policy that has been revised twenty times
 // otherwise pushes its own content off the screen. The entries stay in the DOM either way --
 // <details> hides them from view, not from search engines, find-in-page or assistive
 // technology -- so nothing about the public record depends on this being open.
 - collapsedByDefault (boolean) = true
 + * (crh:revisionEntry)

// One public revision. Authored by an editor; publishing it is what makes it public.
[crh:revisionEntry] > jnt:content, jmix:droppableContent, jmix:editorialContent
 itemtype = content
 - revisionLabel (string) mandatory
 - revisionDate (date) mandatory
 - summary (string, richtext) i18n mandatory
 - changeType (string, choicelist[resourceBundle]) = 'substantive' < 'editorial', 'substantive', 'correction'
 // NOTE: there is deliberately NO snapshotRef property here any more. The link between a
 // revision entry and the snapshot it describes is stored on the SNAPSHOT
 // (crh:revisionSnapshot / crh:entryRefs), pointing back at the entry, for one decisive
 // reason: a crh:revisionEntry is editorial content, so any programmatic write to it bumps
 // jcr:lastModified and the page reads as "modified" in jContent the instant capture binds
 // it -- immediately after the editor published it. That turns every new revision into a
 // two-publication ritual and a support question. A snapshot, by contrast, is system-only and
 // never published, so binding there is invisible to the editorial workflow.
 // The lookup entry -> snapshot is a scan of that page+language folder, which the
 // MAX_SNAPSHOTS_PER_PAGE_LANGUAGE cap bounds at 500 nodes, and it runs only when a visitor
 // actually asks for a comparison.

// Container for the snapshot tree, at all three levels
// (revision-history / <pageUuid> / <language>).
// jmix:droppableContent is a *structural* requirement, not an editorial affordance:
// /sites/<site>/contents is a jnt:contentFolder whose only wildcard child definitions are
// `+ * (jmix:droppableContent)` and `+ * (jnt:contentFolder)`, so without it the root folder
// cannot be created at all (verified: ConstraintViolationException "No child node definition
// for revision-history"). What actually has to be prevented -- the type showing up as a
// component an editor can drop onto a page -- is what jmix:hiddenType does, and that is
// declared here. Child definitions are declared explicitly so crh:revisionSnapshot never
// needs to be droppable either.
// The crh:latest* / crh:snapshotCount properties are a denormalised index on the language
// folder: dedupe used to scan every historical snapshot node -- each carrying a full page's
// Markdown -- on every capture, so its cost grew linearly and forever.
// The crh:lastCapture* properties make a missing snapshot self-explaining: without them a gap
// in the record is indistinguishable from "the content did not change", which is the single
// distinction this feature exists to make.
[crh:snapshotFolder] > jnt:content, jmix:droppableContent, jmix:hiddenType
 - crh:latestHash (string) indexed=no nofulltext
 - crh:latestSnapshot (string) indexed=no nofulltext
 - crh:snapshotCount (long) indexed=no
 - crh:prunedCount (long) indexed=no
 - crh:lastCaptureStatus (string) indexed=no nofulltext
 - crh:lastCaptureMessage (string) indexed=no nofulltext
 - crh:lastCaptureDate (date) indexed=no
 + * (crh:snapshotFolder)
 + * (crh:revisionSnapshot)

// System-generated, never published, never editor-edited. Append-only record.
// indexed=no / nofulltext throughout: historical copies must not pollute site search.
// crh:capturedBy records the principal the render ran as. It is always `guest`: a snapshot is
// destined to be shown publicly, so it is built from what an anonymous visitor can see, never
// from the privileges of whoever triggered the capture.
// crh:markdown is binary, not string, so reading a snapshot's metadata does not drag the whole
// page payload along with it.
[crh:revisionSnapshot] > jnt:content, jmix:hiddenType
 - crh:snapshotDate (date) mandatory indexed=no
 - crh:language (string) mandatory indexed=no nofulltext
 - crh:contentHash (string) mandatory indexed=no nofulltext
 - crh:generatorVersion (string) mandatory indexed=no nofulltext
 - crh:capturedBy (string) mandatory indexed=no nofulltext
 - crh:sourceUrl (string) indexed=no nofulltext
 - crh:markdown (binary) mandatory indexed=no nofulltext
 // Back-references to the crh:revisionEntry nodes this snapshot is the content for. Set by
 // RevisionEntryBinder after each capture attempt; see the note on crh:revisionEntry for why
 // the reference points this way. Multiple, because an editor can author more than one entry
 // between two captures. WEAK references: an entry may be deleted, and a snapshot must never
 // block that or be dragged into referential-integrity failures -- the record of what the
 // page said outlives the editorial description of why it changed.
 - crh:entryRefs (weakreference) multiple indexed=no nofulltext
